# Required for S3 uploads. The bucket must be in this AWS region.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=vyom-backend-demo

# Date-partitioned object-key roots. The application adds YYYY/MM/DD and a unique id.
S3_RECORDING_PREFIX=field-source/recordings
S3_TRANSCRIPT_PREFIX=field-source/transcripts

# Optional presigned URL lifetime (60–3600 seconds).
S3_PRESIGNED_URL_TTL_SECONDS=900

# Local development only: use an AWS CLI profile instead of long-lived keys.
# AWS_PROFILE=your-dev-profile

# The AWS SDK default credential chain also supports these environment values.
# Keep real credentials in this ignored .env file; never add them to Vite env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Backward compatibility for older local setup files; prefer S3_BUCKET_NAME.
# S3_BUCKET=vyom-backend-demo
