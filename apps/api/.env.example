# Audio storage is selected once for the API deployment. Only `local` or `s3` is valid.
# `local` writes to the persistent API machine/VM directory below.
STORAGE_DRIVER=local
LOCAL_RECORDING_DIR=./var/recordings
LOCAL_UPLOAD_STAGING_DIR=./var/upload-staging

# Required to start the API. MongoDB stores visit, recording, and transcript metadata, never audio bytes.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=itc_field_source

# Required server-only OpenAI speech-to-text key. OpenAI transcribes pyannote's speaker clips.
# OpenAI transcribes short per-speaker clips; the Modal diarizer accepts recordings up to 10 minutes.
OPENAI_API_KEY=replace-with-an-openai-api-key

# Manager origin used to check Origin on bootstrap/login/logout and admin writes.
# In production, serve the manager/API from this origin or through one same-origin reverse proxy.
MANAGER_ORIGIN=http://localhost:5180

# Required only when STORAGE_DRIVER=s3. The bucket must be in this AWS region.
# Use the standard AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY variables below or an API runtime role.
# Never add AWS credentials to manager or PWA environment variables.
AWS_REGION=ap-south-1
S3_BUCKET_NAME=vyom-backend-demo

# Date-partitioned object-key roots. The application adds YYYY/MM/DD and a unique id.
S3_RECORDING_PREFIX=field-source/recordings
S3_TRANSCRIPT_PREFIX=field-source/transcripts

# Optional presigned playback/upload URL lifetime (60–3600 seconds).
S3_PRESIGNED_URL_TTL_SECONDS=900

# Keep the AWS access key ID and secret in this ignored .env file; never add them to Vite env.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Backward compatibility for older local setup files; prefer S3_BUCKET_NAME.
# S3_BUCKET=vyom-backend-demo

# Required for audio transcription. The API uses pyannote Community-1 on Modal for speaker turns.
# Authenticate the Modal CLI separately for deployment.
# MODAL_DIARIZATION_URL=https://your-workspace--your-app.modal.run
# MODAL_DIARIZATION_KEY=wk_your_proxy_key
# MODAL_DIARIZATION_SECRET=ws_your_proxy_secret

# FFmpeg must be installed on the API host to decode audio before Modal diarization.
