# The Manager's public HTTPS origin after your VM TLS setup is configured.
# For the provided IP, this may be https://13.232.78.99 (or your HTTPS domain).
MANAGER_ORIGIN=https://13.232.78.99

# The cloud MongoDB connection string is provided separately; database name is optional.
MONGODB_URI=__SET_CLOUD_MONGODB_URI__
MONGODB_DATABASE=itc_field_source

# Required server-side provider configuration.
OPENAI_API_KEY=__SET_OPENAI_API_KEY__
OPENAI_ANALYSIS_MODEL=gpt-4o-mini
MODAL_DIARIZATION_URL=__SET_MODAL_DIARIZATION_URL__
MODAL_DIARIZATION_KEY=__SET_MODAL_DIARIZATION_KEY__
MODAL_DIARIZATION_SECRET=__SET_MODAL_DIARIZATION_SECRET__

# S3 is used for original recordings and denoised analysis audio.
STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
S3_BUCKET_NAME=__SET_S3_BUCKET_NAME__
S3_RECORDING_PREFIX=field-source/recordings
S3_TRANSCRIPT_PREFIX=field-source/transcripts
S3_PRESIGNED_URL_TTL_SECONDS=900

# Either provide AWS keys here or attach a least-privilege instance role to the host.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
